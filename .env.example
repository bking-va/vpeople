# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vpeople

# Auth (NextAuth.js)
AUTH_SECRET=your-secret-key-here
AUTH_URL=http://localhost:3000

# Dedicated Vendasta OIDC client (Admin Center). Do not reuse another app's client.
AUTH_VENDASTA_ID=your-vendasta-oidc-client-id
AUTH_VENDASTA_SECRET=your-vendasta-oidc-client-secret
# Optional. Set only if IAM authorize requires a partner namespace for this
# internal SSO. Supported value is vuni (not AG/account_id, not user-selected).
# AUTH_VENDASTA_PARTNER_ID=vuni

# Optional leftover Google provider; not the vPeople SSO path.
# AUTH_GOOGLE_ID=your-google-oauth-client-id
# AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# For development bypass (set to "true" to enable dev login without Google)
ENABLE_DEV_AUTH=false
# Required in addition to ENABLE_DEV_AUTH before an email can inherit full_admin
ALLOW_DEV_ADMIN_IMPERSONATION=false
# Production also needs this to enable the credentials provider at all
# ALLOW_DEV_AUTH_IN_PRODUCTION=false

# Vercel Cron (fail closed if unset)
# CRON_SECRET=generate-a-long-random-string

# Bamboo API Gateway
# Comma-separated list of valid API keys for the Bamboo-compatible API
BAMBOO_API_KEYS=test-api-key-1,test-api-key-2

# BambooHR inbound sync (read-only). Do not commit the real key.
# BAMBOOHR_API_KEY=your-bamboohr-api-key
# BAMBOOHR_SUBDOMAIN=vendasta
# Optional ATS resume import into private Vercel Blob (CLI --ats-applications)
# BLOB_READ_WRITE_TOKEN=vercel-blob-read-write-token

# Seed API (optional, for production seeding via POST /api/admin/seed)
# Leave unset to disable the seed endpoint
SEED_TOKEN=your-secure-seed-token-here

# Vercel deployment
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# AI candidate matching (server-only; never expose to the client or log the key)
# Coordinator: add ANTHROPIC_API_KEY on Vercel Production + Preview.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional. Default is Claude Sonnet 4.5.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional cost / rate caps (defaults shown)
# ANTHROPIC_MATCH_MAX_CANDIDATES=20
# ANTHROPIC_MATCH_MAX_INPUT_TOKENS=40000
# ANTHROPIC_MATCH_MAX_OUTPUT_TOKENS=4096
# ANTHROPIC_MATCH_MAX_UNCACHED_RESUMES=12
# ANTHROPIC_MATCH_RATE_LIMIT=5
# ANTHROPIC_MATCH_RATE_WINDOW_MS=600000

# vSign e-signature (coordinator sets these). Never commit values.
# Send is never automatic: HR must preview then click send.
# Production vSign is https://vsign.vendasta-internal.com (vendasta/internal-apps apps/vsign).
# Also requires https NEXT_PUBLIC_APP_URL or AUTH_URL so completion webhooks can be registered.
# VSIGN_BASE_URL=https://vsign.vendasta-internal.com
# VSIGN_CLIENT_ID=
# VSIGN_CLIENT_SECRET=
# VSIGN_WEBHOOK_SECRET=
