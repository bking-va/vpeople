# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vpeople

# Auth (NextAuth.js)
AUTH_SECRET=your-secret-key-here
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_URL=http://localhost:3000

# For development bypass (set to "true" to enable dev login without Google)
ENABLE_DEV_AUTH=false

# Bamboo API Gateway
# Comma-separated list of valid API keys for the Bamboo-compatible API
BAMBOO_API_KEYS=test-api-key-1,test-api-key-2

# Seed API (optional, for production seeding via POST /api/admin/seed)
# Leave unset to disable the seed endpoint
SEED_TOKEN=your-secure-seed-token-here

# Vercel deployment
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
